            },
            "title": "Connections",
            "type": "array"
          }
        },
        "title": "AnycostConnectionList",
        "type": "object"
      },
      "event": "",
      "background": false,
      "long_running": false,
      "scopes": [],
      "owner_chat_tool": "tool_cloudzero-connector_chat"
    },
    {
      "name": "get_anycost_billing_drop",
      "description": "Read one AnyCost stream connection's billing drop contents for a given month.",
      "action_type": "read",
      "chain_callable": true,
      "effects": [],
      "id_projection": "",
      "params_schema": {
        "properties": {
          "connection_id": {
            "default": "",
            "description": "Which connected CloudZero account to use (see list_connections). Omit if only one is connected.",
            "title": "Connection Id",
            "type": "string"
          },
          "connection_id_cz": {
            "description": "The CloudZero AnyCost stream connection id.",
            "title": "Connection Id Cz",
            "type": "string"
          },
          "month": {
            "description": "Month to read, YYYY-MM.",
            "title": "Month",
            "type": "string"
          }
        },
        "required": [
          "connection_id_cz",
          "month"
        ],
        "title": "GetAnycostBillingDropParams",
        "type": "object"
