          "month": {
            "default": "",
            "title": "Month",
            "type": "string"
          },
          "record": {
            "additionalProperties": true,
            "title": "Record",
            "type": "object"
          }
        },
        "title": "AnycostBillingDrop",
        "type": "object"
      },
      "event": "",
      "background": false,
